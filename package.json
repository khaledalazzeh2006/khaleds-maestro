{
  "name": "khaleds-maestro",
  "productName": "Maestro",
  "version": "0.9.0",
  "description": "Play the orchestra from your computer keyboard.",
  "author": "Khaled",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "homepage": "https://github.com/khaledalazzeh2006/khaleds-maestro",
  "repository": {
    "type": "git",
    "url": "https://github.com/khaledalazzeh2006/khaleds-maestro.git"
  },
  "build": {
    "appId": "com.khaled.maestro",
    "productName": "Maestro",
    "copyright": "Khaled",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/samples",
        "to": "samples",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Maestro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maestro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "maestro",
        "name": "Maestro piece",
        "description": "Maestro piece",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "khaledalazzeh2006",
        "repo": "khaleds-maestro",
        "releaseType": "release"
      }
    ]
  }
}